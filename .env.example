# Copy to .env and adjust. All keys are optional; defaults live in src/netllm/config.py.

# Ollama server and models
NETLLM_OLLAMA_HOST=http://localhost:11434
NETLLM_CHAT_MODEL=gpt-oss:20b
NETLLM_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Learner profile (a file name in configs/profiles/, without .yaml)
NETLLM_PROFILE=beginner_socratic

# Paths (relative to where you run from, or absolute)
# NETLLM_DATA_DIR=data
# NETLLM_RUNS_DIR=runs
# NETLLM_PROFILES_DIR=configs/profiles
# NETLLM_QUESTIONS_DIR=questions
