# Copy to .env and adjust. Used by both dev modes:
#   - host mode (uv run ...): values below are read as-is, so they point at localhost
#   - full stack (docker compose): compose.yaml re-points hostnames for containers
# Defaults live in src/netllm/config.py. Never commit .env.

# --- Postgres (compose creates the database from these; the app connects with the URL) ---------
POSTGRES_USER=netllm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=netllm
NETLLM_DATABASE_URL=postgresql://netllm:change-me@localhost:5432/netllm

# --- Chroma (server mode) -----------------------------------------------------------------------
NETLLM_CHROMA_HOST=localhost
NETLLM_CHROMA_PORT=8000

# --- MCP server: where clients connect (app, Goose) -------------------------------------------
NETLLM_MCP_URL=http://localhost:8001/mcp
# stdio (spawned by a client) or http (long-running server, like the compose `mcp` service)
NETLLM_MCP_TRANSPORT=stdio
# stub = fixed outputs, no tshark needed (until the pyshark backend is implemented)
NETLLM_PCAP_BACKEND=stub

# --- Ollama -------------------------------------------------------------------------------------
# Host mode: Ollama as seen from the host.
NETLLM_OLLAMA_HOST=http://localhost:11434
# Containers: Ollama as seen from inside Docker. Default is Ollama on the host
# (it must listen on 0.0.0.0: OLLAMA_HOST=0.0.0.0 ollama serve). With `--profile gpu`:
# OLLAMA_BASE_URL=http://ollama:11434
NETLLM_CHAT_MODEL=gemma4:e2b
NETLLM_EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Learner profile (a file name in configs/profiles/, without .yaml) -------------------------
NETLLM_PROFILE=beginner_socratic

# --- Paths (host mode; containers use /data and /runs) -----------------------------------------
# NETLLM_DATA_DIR=data
# NETLLM_RUNS_DIR=runs
# NETLLM_PROFILES_DIR=configs/profiles
# NETLLM_QUESTIONS_DIR=questions
